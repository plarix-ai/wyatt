# Runs the daemon as its own user. Agents reach /run/wyatt/agent.sock by
# being members of the wyatt group. Operators reach the control socket by
# being members of wyatt-ops; approvals are made in their names, which is
# what a rule's `approvers` list matches. Never put an agent in wyatt-ops.
# The audit key stays private to the wyatt user.
#
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin wyatt
#   sudo groupadd --system wyatt-ops
#   sudo usermod -aG wyatt <agent user>
#   sudo usermod -aG wyatt-ops <operator>
#   sudo install -D -m 0644 wyatt.yaml /etc/wyatt/wyatt.yaml
#   sudo install -m 0644 packaging/wyatt.service /etc/systemd/system/
#   sudo systemctl enable --now wyatt
#
# Operators: export WYATT_CONTROL=/run/wyatt/control.sock, then wyatt status,
# wyatt approvals, wyatt approve <id>.

[Unit]
Description=Wyatt runtime policy enforcement for AI agents
Documentation=https://github.com/plarix-ai/wyatt
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wyatt
Group=wyatt
SupplementaryGroups=wyatt-ops
ExecStart=/usr/local/bin/wyatt serve --policy /etc/wyatt/wyatt.yaml --socket /run/wyatt/agent.sock --control /run/wyatt/control.sock --control-group wyatt-ops --state /var/lib/wyatt
ExecReload=/usr/local/bin/wyatt reload --control /run/wyatt/control.sock
Restart=on-failure
# Secrets for ${env:NAME} in the policy, readable by root only.
EnvironmentFile=-/etc/wyatt/env

RuntimeDirectory=wyatt
# Others may pass through to the sockets, whose own modes decide access.
RuntimeDirectoryMode=0751
StateDirectory=wyatt
StateDirectoryMode=0700
UMask=0077

# The daemon only needs what its tools need. Add ReadWritePaths for fs.write
# roots and anything proc tools write to; ProtectHome hides /home, so add
# ReadOnlyPaths or BindReadOnlyPaths for tool roots under it.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# proc tools inherit everything above and below. MemoryDenyWriteExecute is
# left out because it breaks JIT runtimes such as node; add it if no tool
# needs one. Add AF_NETLINK here if a tool runs commands such as `ip`.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Caps processes across the daemon and every tool it runs, including any
# that left their process group with setsid.
TasksMax=512
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
